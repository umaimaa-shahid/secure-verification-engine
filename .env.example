# Copy to .env and fill in. Never commit .env.

# ── SMTP / IMAP (Email Engine — Voyager task 5.2/5.3) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ── Webhook ──
WEBHOOK_SECRET=

# ── QR Generation Service ──

# HMAC-SHA256 signing secret. Minimum 32 characters; the service refuses to
# start without it rather than falling back to a default.
#   openssl rand -hex 32
QR_HASH_SECRET=

# Shared secret Backend Squad A presents as the x-internal-api-key header on
# POST /api/internal/qr/generate. Required to serve the HTTP API.
#   openssl rand -hex 32
INTERNAL_API_KEY=

# Fallback token lifetime, used ONLY when Squad A's document has no expiryDate
# of its own. Default 8760h = 365 days. See docs/qr-payload-spec.md, "Expiry".
QR_EXPIRY_HOURS=8760

# Local PNG cache. Not the source of truth — a missing file is re-rendered.
QR_OUTPUT_DIR=./generated/qrcodes
QR_ERROR_CORRECTION=M
QR_SIZE=300

# Frontend Squad A's verification portal. This is what the QR image encodes:
# the final URL is VERIFICATION_BASE_URL/<qrCodeId>.
VERIFICATION_BASE_URL=http://localhost:3000/verify

# This service's own public origin, used to build the qrImageUrl we return.
PUBLIC_BASE_URL=http://localhost:4000

PORT=4000
LOG_LEVEL=info

# ── Database (shared Supabase Postgres) ──

# Same Supabase project as Backend Squad A, but OUR OWN Postgres schema.
# The ?schema=voyager suffix is required and the service refuses to start
# without it: Prisma writes its _prisma_migrations bookkeeping table into
# whichever schema the URL names, so leaving it off would drop our migration
# history into `public` alongside Squad A's and the two squads would overwrite
# each other.
#
# Use the Supabase "Connection pooling" (pgBouncer, port 6543) string for the
# running service and the direct string (port 5432) for migrations.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=voyager

# Optional. Point the test suite at an existing Postgres instead of the
# throwaway server it starts by default. Never point this at the shared
# Supabase project — the suite creates and drops its own schema.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
